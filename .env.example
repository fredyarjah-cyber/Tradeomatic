# Generate secrets locally; never commit .env. Alphanumeric database password avoids URL escaping.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC
ADMIN_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DATA_MODE=demo
PROVIDER_APPROVED=false
TWELVEDATA_API_KEY=
DATA_ENTITLEMENT=
SCAN_SECONDS=60
REQUEST_SPACING_SECONDS=15

# Set PUBLIC_ORIGIN for production; legacy bearer access is then disabled by default.
PUBLIC_ORIGIN=
COOKIE_SECURE=true
LEGACY_ADMIN_ENABLED=false
ALLOW_LEGACY_RESEARCH_APPROVALS=false
ENCRYPTION_KEY=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=
PUSH_ENABLED=false
OANDA_PAPER_APPROVED=false
OANDA_ELIGIBILITY_VERIFIED=false
OANDA_MT4_LINKED=unknown
OANDA_ACCOUNT_ID=
OANDA_TOKEN=
ALPACA_PAPER_APPROVED=false
ALPACA_ELIGIBILITY_VERIFIED=false
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
BACKUP_ENABLED=false
BACKUP_ENCRYPTION_KEY=
